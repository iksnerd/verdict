#!/bin/sh
# verdict pre-commit: what is staged, not what is on disk.
#
# Enable once per clone:  git config core.hooksPath .githooks
#
# 1. Paths CLAUDE.md says never to commit (data, weights, runs, a DB, experiments with real data).
# 2. A gitleaks scan of the staged diff (default rules; there is no .gitleaks.toml on purpose,
#    since one without `[extend] useDefault = true` silently disables every rule).
# Every check reads ONE snapshot of the index (a tree from `git write-tree`, taken once), so a
# peer `git add` mid-run cannot make what was checked differ from what is committed. A check
# that cannot run says so on a `pre-commit: SKIPPED` line; none is silent.
# 3. The test suite, run against a copy of the index. The working tree may hold unstaged edits
#    that make tests pass or fail for code that is not being committed, and stashing them to hide
#    that would disturb anyone else working in this checkout. Exporting the index touches nothing.
set -eu

repo=$(git rev-parse --show-toplevel)
cd "$repo"

snapshot=""
pytest_pid=""
cleanup() {
  if [ -n "$pytest_pid" ]; then kill "$pytest_pid" 2>/dev/null || true; pytest_pid=""; fi
  if [ -n "$snapshot" ]; then rm -rf "$snapshot"; snapshot=""; fi
  return 0
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# POSIX sh has no pipefail, and a pipeline's status is its last command's: a failed `git diff-tree`
# or `git archive` would pass as an empty diff or a short export. So each git command writes to a
# file, its own exit status is checked, and only then does grep, gitleaks or tar read the file.
snapshot=$(mktemp -d "${TMPDIR:-/tmp}/verdict-precommit.XXXXXX")
work="$snapshot/.precommit"
mkdir "$work"
die() { echo "pre-commit: $1" >&2; exit 1; }

read_head() {
  if git rev-parse --verify -q HEAD >/dev/null; then
    git rev-parse HEAD
  else
    git hash-object -t tree /dev/null
  fi
}

# The one read of the index. Everything below uses $tree. HEAD is read first, then the index, and
# once more if a commit landed between the two, so $base is never older than $tree.
base=$(read_head)
tree=$(git write-tree)
again=$(read_head)
if [ "$again" != "$base" ]; then
  base="$again"
  tree=$(git write-tree)
fi

git diff-tree -r --name-only --no-commit-id --diff-filter=ACMR "$base" "$tree" >"$work/names" ||
  die "git diff-tree failed, so the staged paths cannot be checked"
forbidden=$(grep -E '^(data|models|runs|experiments)/|(^|/)\.env($|\.)|(^|/)apol\.db$' "$work/names" || true)
if [ -n "$forbidden" ]; then
  echo "pre-commit: these must never be committed (see CLAUDE.md, Constraints):" >&2
  echo "$forbidden" | sed 's/^/  /' >&2
  echo "  unstage them: git restore --staged <path>" >&2
  exit 1
fi

if command -v gitleaks >/dev/null 2>&1; then
  # Scan the snapshot's diff from stdin, not `--staged`, which would read the index again.
  git diff-tree -p --no-color --no-commit-id "$base" "$tree" >"$work/staged.diff" ||
    die "git diff-tree failed, so the staged changes cannot be scanned for secrets"
  if ! gitleaks stdin --no-banner --redact <"$work/staged.diff" >/dev/null 2>&1; then
    gitleaks stdin --no-banner --redact <"$work/staged.diff" >&2 || true
    echo "pre-commit: gitleaks found a secret in the staged changes" >&2
    exit 1
  fi
else
  echo "pre-commit: SKIPPED secret scan: gitleaks not installed (brew install gitleaks)" >&2
fi

python="$repo/.venv/bin/python"
if [ ! -x "$python" ]; then
  echo "pre-commit: no .venv; run: uv sync --extra mlx --extra laya --extra jev" >&2
  exit 1
fi
# Without the extras the laya-dependent tests skip and the suite still passes. Say so: a plain
# `uv sync` removes them, and a green hook would then cover less than it appears to.
if ! "$python" -c 'import importlib.util as u, sys; sys.exit(0 if all(u.find_spec(m) for m in ("mlx", "laya_mlx")) else 1)'; then
  echo "pre-commit: WARNING: this .venv lacks the mlx or laya extras, so the tests that need them" >&2
  echo "  are skipped. Restore them: uv sync --extra mlx --extra laya --extra jev" >&2
  echo "pre-commit: SKIPPED mlx/laya tests: extras missing from .venv" >&2
fi
git archive "$tree" >"$work/tree.tar" || die "git archive failed, so the snapshot cannot be exported"
tar -x -C "$snapshot" -f "$work/tree.tar" || die "could not unpack the snapshot"
# PYTHONPATH beats the editable install, which would otherwise import the working tree. Pytest runs
# in the background and is waited on, so a TERM or INT to this shell runs the trap, which kills it.
(cd "$snapshot" && exec env PYTHONPATH="$snapshot/src" "$python" -m pytest -q -p no:cacheprovider \
  >"$snapshot/.pytest.log" 2>&1) &
pytest_pid=$!
if wait "$pytest_pid"; then status=0; else status=$?; fi
pytest_pid=""
if [ "$status" -ne 0 ]; then
  tail -25 "$snapshot/.pytest.log" >&2
  echo "pre-commit: tests fail on the staged snapshot" >&2
  exit 1
fi
tail -1 "$snapshot/.pytest.log"
